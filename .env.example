# Token from @BotFather (required)
BOT_TOKEN=123456789:replace-me

# Optional: comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
ALLOWED_USER_IDS=

# Optional: catbox.moe account hash, so uploads appear in your catbox account
CATBOX_USERHASH=

# Fallback host lifetime if catbox refuses uploads: 1h, 12h, 24h or 72h
LITTERBOX_TIME=72h

# Use custom emoji icons in the bot's own messages and buttons (needs bot owner with Telegram Premium).
# The bot falls back to plain emoji automatically if Telegram refuses them. Set to 0 to always use plain emoji.
USE_CUSTOM_EMOJI=1

# Max seconds spent downloading previews per pack; missing ones show as "no preview"
DOWNLOAD_BUDGET=150
